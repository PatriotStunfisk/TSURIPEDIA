# Public URL
# Canonical origin is defined in lib/site-url.ts (https://uolink.jp).

# Phase 2 CMS/Auth (recommended: Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics / Ads (add after policies and consent handling are ready)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional community reports. Apply reviewed supabase/catch-reports.sql first.
# Server-only enable switch: do not enable before moderation is staffed.
CATCH_REPORTS_ENABLED=false

# Optional photo identification (paid API; separate from ChatGPT subscription).
# Set server-side only after approving the provider/budget. Requires the quota SQL above.
OPENAI_API_KEY=
FISH_IDENTIFY_MODEL=
FISH_IDENTIFY_ENABLED=false

# Server-only catch storage URL; takes precedence over NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# OAuth is configured in Supabase Auth > Providers (Google / Apple).
# Client secrets belong in Supabase, not in this application or repository.
# Optional publishable/legacy anon key, server-side auth only. Existing service key is a server-only fallback.
SUPABASE_ANON_KEY=

# Enable only after applying supabase/catch-activity.sql and approving source permissions.
CATCH_EXTERNAL_ENABLED=
CRON_SECRET=
